# ─────────────────────────────────────────────
#  Aria — шаблон переменных окружения
#  Скопируй в .env и заполни своими значениями
# ─────────────────────────────────────────────

# ── База данных (PostgreSQL) ──────────────────
# Railway: берётся из переменной DATABASE_URL автоматически
# Локально: postgresql://user:password@localhost:5432/aria_salon
DATABASE_URL=postgresql://user:password@localhost:5432/aria_salon

# ── Claude / Anthropic ────────────────────────
# Получить на: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (Whisper — транскрипция голосовых) ─
# Получить на: https://platform.openai.com/api-keys
# Оставь пустым, если голосовые сообщения не нужны
OPENAI_API_KEY=

# ── Управляющий бот (главный, видит admin-панель) ──
# Токен от @BotFather для бота-администратора
MANAGEMENT_BOT_TOKEN=123456789:AAF...

# ── Первый салонный бот (создаётся при первом запуске) ──
# Токен от @BotFather для бота первого салона
ARIA_BOT_TOKEN=987654321:AAG...

# ── Владелец / администратор ──────────────────
# Твой числовой Telegram ID (узнать: @userinfobot)
ARIA_OWNER_TELEGRAM_ID=123456789

# ── Настройки первого салона ──────────────────
SALON_NAME=Мой салон
SALON_OWNER_NAME=Имя мастера
SALON_SERVICES=Стрижка, Маникюр, Окрашивание
SALON_HOURS=Пн-Сб 10:00-20:00
SALON_OPEN_HOUR=10
SALON_CLOSE_HOUR=20
SALON_SLOT_MINUTES=60
# Рабочие дни: 1=Пн, 2=Вт, 3=Ср, 4=Чт, 5=Пт, 6=Сб, 7=Вс
SALON_WORKING_DAYS=1,2,3,4,5,6

# ── Webhook (для Railway/деплоя) ──────────────
# Пример: https://aria-bot.up.railway.app
# Оставь пустым для polling (локальная разработка)
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# ── Google Calendar (опционально) ────────────
# Заполняется через настройки бота, не вручную
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=
