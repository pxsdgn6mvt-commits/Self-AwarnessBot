# ── Required ──────────────────────────────────────────────────────────────────
ARIA_BOT_TOKEN=<your Telegram bot token from @BotFather>
ANTHROPIC_API_KEY=<your Anthropic API key>
ARIA_OWNER_TELEGRAM_ID=<your Telegram numeric user id — for escalation alerts>
ARIA_DATABASE_URL=postgresql://user:password@host:5432/aria_salon

# ── Salon identity ─────────────────────────────────────────────────────────────
SALON_NAME=Lumina Beauty Studio
SALON_OWNER_NAME=Anna
SALON_SERVICES=haircut, blow-dry, coloring, highlights, manicure, pedicure, facial, massage
SALON_HOURS=Mon–Sat 10:00–20:00
SALON_BOOKING_LINK=
SALON_ESCALATION_HOURS=2

# ── Schedule grid ──────────────────────────────────────────────────────────────
SALON_OPEN_HOUR=10
SALON_CLOSE_HOUR=20
SALON_SLOT_MINUTES=60
SALON_WORKING_DAYS=1,2,3,4,5,6   # ISO weekday: 1=Mon … 7=Sun

# ── Upsell pairs (service:complementary, comma-separated) ─────────────────────
SALON_UPSELL_PAIRS=haircut:coloring,manicure:pedicure,facial:massage

# ── Claude model (change to claude-sonnet-4-6 for harder tasks) ───────────────
ARIA_CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Google Calendar integration (optional) ────────────────────────────────────
# Leave blank to use the built-in Postgres scheduler instead.
# GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account", ...}   (full JSON as string)
# GOOGLE_CALENDAR_ID=primary
